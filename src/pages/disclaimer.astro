---
import { getEntry, render } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const page = await getEntry('legal','disclaimer'); if (!page) throw new Error('Disclaimer content is missing'); const { Content } = await render(page);
---
<BaseLayout title={page.data.seoTitle}><PageHero eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.introduction}/><section class="section"><div class="narrow prose"><Content/></div></section></BaseLayout>
