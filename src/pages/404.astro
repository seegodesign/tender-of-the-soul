---
import BaseLayout from '../layouts/BaseLayout.astro'; import page from '../data/notFound.json';
---
<BaseLayout title={page.seoTitle}><section class="not-found"><div class="container"><p class="eyebrow">{page.eyebrow}</p><h1>{page.heading}</h1><p>{page.body}</p><div><a class="button" href="/">{page.homeButton}</a><a class="button outline" href="/contact">{page.contactButton}</a></div></div></section></BaseLayout>
<style>.not-found{min-height:80vh;display:grid;place-items:center;padding:10rem 0 5rem;background:var(--cream)}.not-found h1{max-width:850px}.not-found p:not(.eyebrow){max-width:550px;margin:1.5rem 0 2rem;font:1.3rem var(--serif)}.not-found div div{display:flex;gap:1rem;flex-wrap:wrap}</style>
