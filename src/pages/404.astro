---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page Not Found | Tender of the Soul"><section class="not-found"><div class="container"><p class="eyebrow">404 · A quiet detour</p><h1>This page has wandered out of view.</h1><p>The path may have changed, or the page may no longer be here. You can return home or begin a conversation.</p><div><a class="button" href="/">Return Home</a><a class="button outline" href="/contact">Contact Elana</a></div></div></section></BaseLayout>
<style>.not-found{min-height:80vh;display:grid;place-items:center;padding:10rem 0 5rem;background:var(--cream)}.not-found h1{max-width:850px}.not-found p:not(.eyebrow){max-width:550px;margin:1.5rem 0 2rem;font:1.3rem var(--serif)}.not-found div div{display:flex;gap:1rem;flex-wrap:wrap}</style>
