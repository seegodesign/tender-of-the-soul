---
import { getEntry, render } from 'astro:content'; import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
const page = await getEntry('legal','privacy'); if (!page) throw new Error('Privacy content is missing'); const { Content } = await render(page);
---
<BaseLayout title={page.data.seoTitle}><PageHero eyebrow={page.data.eyebrow} title={page.data.title} intro={page.data.introduction}/><section class="section"><div class="narrow prose">{page.data.updatedLabel && <p><strong>{page.data.updatedLabel}</strong></p>}<Content/></div></section></BaseLayout>
