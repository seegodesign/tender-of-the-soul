---
import BaseLayout from '../layouts/BaseLayout.astro';
import Principles from '../components/Principles.astro';
import home from '../data/home.json';
---
<BaseLayout title="Tender of the Soul | Hakomi & Somatic Work on Kauaʻi">
  <section class="hero">
    <div class="hero-image" role="img" aria-label={home.hero.imageAlt}></div>
    <div class="container hero-content">
      <p class="eyebrow">{home.hero.eyebrow}</p>
      <h1>{home.hero.headline}</h1>
      <p class="intro">{home.hero.introduction}</p>
      <div class="actions"><a class="button" href="/contact">{home.hero.primaryCta}</a><a class="button outline" href="/hakomi">{home.hero.secondaryCta}</a></div>
      <p class="location"><span></span> {home.hero.locationLine}</p>
    </div>
  </section>

  <section class="section welcome"><div class="container grid-2">
    <div><p class="eyebrow">{home.welcome.eyebrow}</p><h2>{home.welcome.heading}</h2></div>
    <div><p class="lead">{home.welcome.statement}</p><p class="muted">{home.welcome.body}</p><a class="text-link" href="/about">{home.welcome.linkLabel} <span>→</span></a></div>
  </div></section>

  <section class="section insight"><div class="container grid-2">
    <div class="arch" aria-hidden="true"><div></div><span>{home.insight.diagramLabelOne}</span><span>{home.insight.diagramLabelTwo}</span></div>
    <div><p class="eyebrow">{home.insight.eyebrow}</p><h2>{home.insight.heading}</h2><p class="lead">{home.insight.lead}</p><p>{home.insight.paragraphOne}</p><p>{home.insight.paragraphTwo}</p><a class="text-link" href="/hakomi">{home.insight.linkLabel} <span>→</span></a></div>
  </div></section>

  <section class="section approach"><div class="container"><div class="approach-head"><div><p class="eyebrow">{home.approach.eyebrow}</p><h2>{home.approach.heading}</h2></div><p>{home.approach.introduction}</p></div><Principles items={home.approach.principles}/></div></section>

  <section class="section permission"><div class="container grid-2">
    <div><p class="eyebrow">{home.permission.eyebrow}</p><h2>{home.permission.heading}</h2><p>{home.permission.paragraphOne}</p><p>{home.permission.paragraphTwo}</p></div>
    <blockquote><p>“{home.permission.quote}”</p><cite>{home.permission.attribution}</cite></blockquote>
  </div></section>

  <section class="section possibility"><div class="container"><p class="eyebrow">{home.possibility.eyebrow}</p><h2>{home.possibility.heading}</h2><div class="possibility-grid">{home.possibility.items.map(item => <p>{item}</p>)}</div></div></section>

  <section class="section sessions-preview"><div class="container grid-2"><div><p class="eyebrow">{home.sessions.eyebrow}</p><h2>{home.sessions.heading}</h2><p>{home.sessions.introduction}</p><a class="button outline" href="/sessions">{home.sessions.buttonLabel}</a></div><div class="session-card"><span>{home.sessions.cardHeading}</span><ul>{home.sessions.items.map(item => <li>{item}</li>)}</ul></div></div></section>
</BaseLayout>
<style>
  .hero{position:relative;min-height:820px;height:100svh;display:flex;align-items:center;background:#d8d8c8;overflow:hidden}.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(243,238,226,.95) 0%,rgba(243,238,226,.76) 42%,rgba(243,238,226,.04) 74%)}.hero-image{position:absolute;inset:0;background:url('/images/uploads/kauai-hero.avif') center/cover no-repeat}.hero-content{position:relative;z-index:2;padding-top:6rem}.hero h1{max-width:790px;font-size:clamp(4rem,8vw,7.8rem)}.hero .intro{max-width:620px;margin:1.5rem 0 2rem;font-size:1.05rem}.actions{display:flex;gap:1rem;flex-wrap:wrap}.location{display:flex;align-items:center;gap:.7rem;margin-top:3rem;font-size:.76rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase}.location span{width:26px;height:1px;background:var(--clay)}.welcome{background:var(--paper)}.welcome h2{max-width:580px}.insight{background:var(--cream)}.arch{position:relative;min-height:560px;border:1px solid var(--line);background:radial-gradient(circle at 50% 80%,rgba(200,117,93,.35),transparent 32%),linear-gradient(155deg,var(--mist),#d0d7c6);overflow:hidden}.arch div{position:absolute;width:75%;height:80%;left:12.5%;bottom:-20%;border:1px solid rgba(32,53,47,.35);border-radius:50% 50% 0 0}.arch div::before,.arch div::after{content:"";position:absolute;inset:12%;border:1px solid rgba(32,53,47,.25);border-radius:50% 50% 0 0}.arch div::after{inset:25%}.arch span{position:absolute;font:1.3rem var(--serif)}.arch span:nth-of-type(1){top:12%;left:10%}.arch span:nth-of-type(2){bottom:9%;right:8%}.approach-head{display:grid;grid-template-columns:1.3fr .7fr;gap:5rem;align-items:end;margin-bottom:4rem}.approach-head>p{color:#566a63}.permission{background:var(--forest);color:var(--cream)}.permission p{color:#c7d0c2}.permission blockquote{margin:0;padding:3rem;border:1px solid rgba(255,255,255,.25)}.permission blockquote p{color:var(--cream);font:clamp(1.7rem,3vw,2.8rem)/1.3 var(--serif)}.permission cite{color:var(--sage);font-size:.75rem;font-style:normal;text-transform:uppercase;letter-spacing:.12em}.possibility h2{max-width:920px}.possibility-grid{display:grid;grid-template-columns:repeat(4,1fr);margin-top:4rem;border-top:1px solid var(--line)}.possibility-grid p{padding:2rem 1.5rem;border-right:1px solid var(--line);font:1.5rem/1.25 var(--serif)}.sessions-preview{background:var(--mist)}.session-card{padding:clamp(2rem,5vw,4rem);background:var(--paper);box-shadow:var(--shadow)}.session-card span{font-size:.75rem;text-transform:uppercase;letter-spacing:.14em;color:var(--clay-dark)}.session-card ul{margin:2rem 0 0;padding:0;list-style:none}.session-card li{padding:.7rem 0;border-bottom:1px solid var(--line);font-family:var(--serif);font-size:1.25rem}
  @media(max-width:760px){.hero{min-height:760px}.hero::after{background:linear-gradient(90deg,rgba(243,238,226,.94),rgba(243,238,226,.55))}.approach-head{grid-template-columns:1fr;gap:1.5rem}.possibility-grid{grid-template-columns:1fr 1fr}.arch{min-height:380px;order:2}}
</style>
