---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);
import page from "../../data/journal.json";
---

<BaseLayout title={page.seo.title} description={page.seo.description}
  ><PageHero
    eyebrow={page.hero.eyebrow}
    title={page.hero.title}
    intro={page.hero.introduction}
  />
  <section class="section">
    <div class="container posts">
      {
        posts.map((post, i) => (
          <article>
            <a href={`/blog/${post.id}/`}>
              <>
                <div class="visual">
                  {post.data.featuredImage ? (
                    <img
                      src={post.data.featuredImage}
                      alt={post.data.featuredImageAlt || post.data.title}
                    />
                  ) : (
                    <span>{String(i + 1).padStart(2, "0")}</span>
                  )}
                </div>
                <div>
                  <>
                    <p class="meta">
                      {post.data.category} ·{" "}
                      {post.data.publishDate.toLocaleDateString("en-US", {
                        month: "long",
                        day: "numeric",
                        year: "numeric",
                      })}
                    </p>
                    <h2>{post.data.title}</h2>
                    <p class="excerpt">{post.data.excerpt}</p>
                    <span class="text-link">{page.readLabel} →</span>
                  </>
                </div>
              </>
            </a>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>
<style>
  .posts {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .posts article {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .posts article a {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .posts a {
    text-decoration: none;
  }
  .visual {
    position: relative;
    display: grid;
    min-height: 450px;
    place-items: center;
    overflow: hidden;
  }
  .visual span {
    font: 4rem var(--serif);
    color: rgba(32, 53, 47, 0.28);
  }
  .visual img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .meta {
    margin-top: 1.2rem;
    color: var(--clay-dark);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .posts h2 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 1rem;
  }
  .excerpt {
    white-space: pre-line;
  }
  @media (max-width: 700px) {
    .posts article a {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }
</style>
