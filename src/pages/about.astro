---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import about from "../data/about.json";
---

<BaseLayout title={about.seo.title} description={about.seo.description}
  ><PageHero
    eyebrow={about.hero.eyebrow}
    title={about.hero.title}
    intro={about.hero.introduction}
  />
  <section class="section">
    <div class="container grid-2">
      <div
        class:list={["portrait", { "has-image": about.portrait.image }]}
        style={about.portrait.image
          ? `background-image:url(${about.portrait.image})`
          : undefined}
        role={about.portrait.image ? "img" : undefined}
        aria-label={about.portrait.image ? about.portrait.altText : undefined}
      >
        {
          !about.portrait.image && (
            <span>
              {about.portrait.placeholderHeading}
              <br />
              <small>{about.portrait.placeholderNote}</small>
            </span>
          )
        }
      </div><div>
        <p class="eyebrow">{about.introduction.eyebrow}</p><h2>
          {about.introduction.heading}
        </h2><p class="lead">{about.introduction.statement}</p><p>
          {about.introduction.paragraphOne}
        </p><p>{about.introduction.paragraphTwo}</p>
      </div>
    </div>
  </section>
  <section class="section soft-panel">
    <div class="narrow">
      <p class="eyebrow">{about.orientation.eyebrow}</p><h2>
        {about.orientation.heading}
      </h2><p class="lead">{about.orientation.statement}</p><p>
        {about.orientation.body}
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container credentials">
      <div>
        <p class="eyebrow">{about.credentials.eyebrow}</p><h2>
          {about.credentials.heading}
        </h2><p>{about.credentials.introduction}</p>
      </div><dl>
        {
          about.credentials.items.map((item) => (
            <div>
              <>
                <dt>{item.label}</dt>
                <dd>{item.description}</dd>
              </>
            </div>
          ))
        }
      </dl>
    </div>
  </section>
</BaseLayout>
<style>
  .portrait {
    display: grid;
    min-height: 620px;
    place-items: center;
    background: linear-gradient(145deg, #cbd3c4, #8fa28d);
    color: var(--forest);
    text-align: center;
    font-family: var(--serif);
    font-size: 1.5rem;
  }
  .portrait.has-image {
    background-position: center;
    background-size: cover;
  }
  .portrait small {
    font: 600 0.65rem var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .credentials {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: 5rem;
  }
  .credentials dl {
    margin: 0;
  }
  .credentials dl div {
    display: grid;
    grid-template-columns: 0.55fr 1fr;
    padding: 1.3rem 0;
    border-top: 1px solid var(--line);
  }
  dt {
    font-weight: 600;
  }
  dd {
    margin: 0;
    color: #687872;
  }
  @media (max-width: 760px) {
    .credentials {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .credentials dl div {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .portrait {
      min-height: 450px;
    }
  }
</style>
