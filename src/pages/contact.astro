---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro';
---
<BaseLayout title="Contact | Tender of the Soul"><PageHero eyebrow="Begin a conversation" title="You can start without having all the words." intro="Reach out to schedule a complimentary discovery call. We can talk about what brings you here and whether working together feels like a good fit."/>
<section class="section"><div class="container contact-grid"><div><p class="eyebrow">Discovery call</p><h2>A simple first step.</h2><p>The form is not a commitment to begin sessions. Elana will respond with options for a brief conversation where you can ask questions and get a sense of the work.</p><dl><div><dt>Location</dt><dd>Kauaʻi, Hawaiʻi · online and in person</dd></div><div><dt>Session length</dt><dd>60–90 minutes</dd></div><div><dt>Response time</dt><dd>Typically within 2–3 business days</dd></div><div><dt>Email</dt><dd>[Add practice email in CMS]</dd></div></dl><aside><strong>Please do not use this form for urgent support.</strong> Tender of the Soul does not provide crisis services. If you are in immediate danger, contact local emergency services or an appropriate crisis resource in your area.</aside></div>
<form name="discovery-call" method="POST" data-netlify="true" netlify-honeypot="bot-field"><input type="hidden" name="form-name" value="discovery-call"><p class="sr-only"><label>Don’t fill this out: <input name="bot-field"></label></p><div class="field-row"><label>First name<input name="first-name" autocomplete="given-name" required></label><label>Last name<input name="last-name" autocomplete="family-name"></label></div><label>Email address<input type="email" name="email" autocomplete="email" required></label><label>Phone number <span>Optional</span><input type="tel" name="phone" autocomplete="tel"></label><fieldset><legend>How would you prefer to meet?</legend><label class="radio"><input type="radio" name="meeting" value="online"> Online</label><label class="radio"><input type="radio" name="meeting" value="in-person"> In person on Kauaʻi</label><label class="radio"><input type="radio" name="meeting" value="unsure"> I’m not sure yet</label></fieldset><label>What would you like Elana to know?<span>Please avoid including highly sensitive medical information.</span><textarea name="message" rows="6" required></textarea></label><label class="consent"><input type="checkbox" required name="consent"> I understand this form is not monitored for urgent or crisis support.</label><button class="button" type="submit">Send My Note <span aria-hidden="true">→</span></button><p class="form-note">Your information is used only to respond to your inquiry. Please review the <a href="/privacy">privacy policy</a>.</p></form></div></section>
</BaseLayout>
<style>.contact-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem);align-items:start}.contact-grid dl div{padding:1rem 0;border-top:1px solid var(--line)}dt{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--clay-dark)}dd{margin:.25rem 0 0;font-family:var(--serif);font-size:1.2rem}aside{margin-top:2rem;padding:1.2rem;background:var(--mist);font-size:.78rem}form{padding:clamp(1.5rem,4vw,3rem);background:var(--cream);box-shadow:var(--shadow)}label,legend{display:block;margin-bottom:1.25rem;font-size:.78rem;font-weight:600}label span{float:right;color:#718078;font-weight:400}input,textarea{width:100%;margin-top:.45rem;padding:.85rem .15rem;border:0;border-bottom:1px solid #89968e;border-radius:0;background:transparent;color:var(--ink);font:1rem var(--sans)}input:focus,textarea:focus{outline:2px solid var(--clay);outline-offset:3px}.field-row{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem}fieldset{margin:0 0 1.5rem;padding:0;border:0}.radio{display:inline-flex;align-items:center;gap:.4rem;margin-right:1rem;font-weight:400}.radio input,.consent input{width:auto;margin:0}.consent{display:flex;gap:.7rem}.form-note{margin-top:1rem;font-size:.72rem}@media(max-width:800px){.contact-grid{grid-template-columns:1fr}.field-row{grid-template-columns:1fr}}</style>
