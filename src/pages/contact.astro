---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import contact from "../data/contact.json";
---

<BaseLayout title={contact.seo.title} description={contact.seo.description}>
  <PageHero
    eyebrow={contact.hero.eyebrow}
    title={contact.hero.title}
    intro={contact.hero.introduction}
  />
  <section class="section">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">{contact.introduction.eyebrow}</p>
        <h2>{contact.introduction.heading}</h2>
        <p>{contact.introduction.body}</p>
        <dl>
          {
            contact.details.map((detail) => (
              <div>
                <>
                  <dt>{detail.label}</dt>
                  <dd>{detail.value}</dd>
                </>
              </div>
            ))
          }
        </dl>
        <aside>
          <strong>{contact.urgentNotice.heading}</strong>
          {contact.urgentNotice.body}
        </aside>
      </div>
      <div class="form-panel">
        <form
          id="discovery-call"
          name="discovery-call"
          action="https://submit-form.com/wkoysmRn9"
          method="POST"
          data-error-message={contact.form.errorMessage}
        >
        <p class="sr-only">
          <label
            >Leave this field empty
            <input
              type="text"
              name="_honeypot"
              tabindex="-1"
              autocomplete="off"
            /></label
          >
        </p>
        <div class="field-row">
          <label
            >{contact.form.firstNameLabel}<input
              name="first-name"
              autocomplete="given-name"
              required
            /></label
          >
          <label
            >{contact.form.lastNameLabel}<input
              name="last-name"
              autocomplete="family-name"
            /></label
          >
        </div>
        <label
          >{contact.form.emailLabel}<input
            type="email"
            name="email"
            autocomplete="email"
            required
          /></label
        >
        <label
          >{contact.form.phoneLabel}
          <span>{contact.form.optionalLabel}</span><input
            type="tel"
            name="phone"
            autocomplete="tel"
          /></label
        >
        <fieldset>
          <legend>{contact.form.meetingLegend}</legend>
          {
            contact.form.meetingOptions.map((option) => (
              <label class="radio">
                <input type="radio" name="meeting" value={option.value} />{" "}
                {option.label}
              </label>
            ))
          }
        </fieldset>
        <label
          >{contact.form.messageLabel}<span>{contact.form.messageGuidance}</span
          ><textarea name="message" rows="6" required></textarea></label
        >
        <label class="consent"
          ><input type="checkbox" required name="consent" />
          {contact.form.consentLabel}</label
        >
        <p class="form-status" data-form-status hidden role="alert"></p>
        <button class="button" type="submit"
          >{contact.form.buttonLabel} <span aria-hidden="true">→</span></button
        >
        <p class="form-note">
          {contact.form.privacyPrefix}
          <a href="/privacy">{contact.form.privacyLinkLabel}</a>.
        </p>
      </form>
      <div class="form-success" data-form-success hidden tabindex="-1">
        <p class="eyebrow">Sent</p>
        <h2>{contact.form.successHeading}</h2>
        <p>{contact.form.successBody}</p>
      </div>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  .contact-grid dl div {
    padding: 1rem 0;
    border-top: 1px solid var(--line);
  }
  dt {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--clay-dark);
  }
  dd {
    margin: 0.25rem 0 0;
    font-family: var(--serif);
    font-size: 1.2rem;
  }
  aside {
    margin-top: 2rem;
    padding: 1.2rem;
    background: var(--mist);
    font-size: 0.78rem;
  }
  .form-panel {
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--cream);
    box-shadow: var(--shadow);
  }
  .form-status {
    margin: 0 0 1rem;
    color: var(--clay-dark);
    font-size: 0.95rem;
  }
  .form-success h2 {
    margin-bottom: 1rem;
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  label,
  legend {
    display: block;
    margin-bottom: 1.25rem;
    font-size: 1.05rem;
    font-weight: 600;
  }
  label span {
    color: var(--ink);
    font-weight: 400;
    display: block;
  }
  input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]),
  textarea {
    width: 100%;
    margin-top: 0.45rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid #89968e;
    border-radius: 4px;
    background: var(--paper);
    color: var(--ink);
    font: 1.2rem var(--sans);
  }
  input:not([type="radio"]):not([type="checkbox"]):not([type="hidden"]):focus,
  textarea:focus {
    outline: 2px solid var(--clay);
    outline-offset: 3px;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  fieldset {
    margin: 0 0 1.5rem;
    padding: 0;
    border: 0;
  }
  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-right: 1rem;
    font-weight: 400;
  }
  .radio input,
  .consent input {
    width: auto;
    margin: 0;
  }
  .consent {
    display: flex;
    gap: 0.7rem;
  }
  .form-note {
    margin-top: 1rem;
    font-size: 0.92rem;
  }
  @media (max-width: 800px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>
<script>
  const FORM_ACTION = "https://submit-form.com/wkoysmRn9";

  function initContactForm() {
    const form = document.querySelector<HTMLFormElement>("#discovery-call");
    const status = document.querySelector<HTMLElement>("[data-form-status]");
    const success = document.querySelector<HTMLElement>("[data-form-success]");
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

    if (!form || !status || !success || !button || form.dataset.bound === "true") {
      return;
    }

    form.dataset.bound = "true";
    const defaultLabel = button.innerHTML;
    const errorMessage =
      form.dataset.errorMessage ??
      "Something went wrong sending your note. Please try again in a moment.";

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      status.hidden = true;
      status.textContent = "";
      button.disabled = true;
      button.textContent = "Sending…";

      const payload = Object.fromEntries(new FormData(form));

      try {
        const response = await fetch(FORM_ACTION, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        form.hidden = true;
        success.hidden = false;
        success.focus();
        success.scrollIntoView({ behavior: "smooth", block: "nearest" });
      } catch {
        status.textContent = errorMessage;
        status.hidden = false;
        button.disabled = false;
        button.innerHTML = defaultLabel;
      }
    });
  }

  document.addEventListener("astro:page-load", initContactForm);
</script>
