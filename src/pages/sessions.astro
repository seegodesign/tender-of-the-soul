---
import BaseLayout from '../layouts/BaseLayout.astro'; import PageHero from '../components/PageHero.astro'; import page from '../data/sessions.json';
---
<BaseLayout title={page.seo.title} description={page.seo.description}><PageHero eyebrow={page.hero.eyebrow} title={page.hero.title} intro={page.hero.introduction}/>
<section class="section"><div class="container details">{page.details.map(item=><article><span>{item.number}</span><h3>{item.heading}</h3><p>{item.body}</p></article>)}</div></section>
<section class="section soft-panel"><div class="container grid-2"><div><p class="eyebrow">{page.expect.eyebrow}</p><h2>{page.expect.heading}</h2><p>{page.expect.paragraphOne}</p><p>{page.expect.paragraphTwo}</p></div><ol class="flow">{page.expect.steps.map(step=><li><span>{step.heading}</span><p>{step.body}</p></li>)}</ol></div></section>
<section class="section"><div class="container grid-2"><div class="quote"><p>“{page.choice.quote}”</p></div><div><p class="eyebrow">{page.choice.eyebrow}</p><h2>{page.choice.heading}</h2><p>{page.choice.paragraphOne}</p><p>{page.choice.paragraphTwo}</p></div></div></section>
<section class="section first"><div class="narrow"><p class="eyebrow">{page.firstSession.eyebrow}</p><h2>{page.firstSession.heading}</h2><p class="lead">{page.firstSession.statement}</p><p>{page.firstSession.body}</p><a class="button" href="/contact">{page.firstSession.buttonLabel}</a></div></section></BaseLayout>
<style>.details{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line)}.details article{padding:2rem;border-right:1px solid var(--line)}.details span{color:var(--clay-dark);font-size:.7rem}.details h3{margin:2rem 0 .8rem}.flow{list-style:none;margin:0;padding:0}.flow li{display:grid;grid-template-columns:.6fr 1fr;padding:1rem 0;border-bottom:1px solid var(--line)}.flow span{font:1.5rem var(--serif)}.first{background:var(--mist)}@media(max-width:700px){.details{grid-template-columns:1fr}.details article{border-right:0;border-bottom:1px solid var(--line)}}</style>
