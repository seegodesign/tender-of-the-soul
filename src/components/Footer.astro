---
import site from "../data/site.json";
const turnstileSitekey = import.meta.env.DEV
  ? "1x00000000000000000000AA"
  : import.meta.env.PUBLIC_TURNSTILE_SITEKEY || "0x4AAAAAAGRvXLKyAKNqo4sB";
---

<footer>
  {Astro.url.pathname === "/" && <section class="cta">
    <div class="container">
      <p class="eyebrow">{site.footer.ctaEyebrow}</p>
      <h2>{site.footer.ctaHeading}</h2>
      <p>{site.footer.ctaBody}</p>
      <a class="button" href="/contact"
        >{site.footer.ctaButton} <span aria-hidden="true">→</span></a
      >
    </div>
  </section>}
  <div class="foot container">
    <div>
      <a class="wordmark" href="/">{site.practiceName}</a>
      <p>{site.footer.practiceDescription}<br />{site.footer.locationLine}</p>
    </div>
    <div class="links">
      <a href="/about">{site.navigation.about}</a><a href="/hakomi"
        >{site.navigation.hakomi}</a
      ><a href="/sessions">{site.navigation.sessions}</a><a href="/faqs"
        >{site.navigation.faqs}</a
      ><a href="/blog">{site.navigation.journal}</a><a href="/contact"
        >{site.navigation.contact}</a
      >
    </div>
    <div class="newsletter">
      <h2 id="newsletter-heading">Sign up for my newsletter</h2>
      <p>Reflections and updates from Tender of the Soul, delivered to your inbox.</p>
      <form action="/api/newsletter" method="POST" aria-labelledby="newsletter-heading" data-newsletter-form>
        <label for="newsletter-email">Email address</label>
        <input id="newsletter-email" name="email" type="email" autocomplete="email" placeholder="Your email address" required maxlength="254" />
        <div class="newsletter-trap" aria-hidden="true">
          <label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="newsletter-note">By signing up, you agree to receive my newsletter. Unsubscribe anytime. <a href="/privacy">Privacy policy</a>.</p>
        {turnstileSitekey && <div class="newsletter-bot-check" data-newsletter-turnstile data-sitekey={turnstileSitekey}></div>}
        <button class="button" type="submit" disabled>Sign up <span aria-hidden="true">→</span></button>
        <p class="newsletter-status" role="status" aria-live="polite" data-newsletter-status>{turnstileSitekey ? "Loading bot check…" : "Newsletter signup is temporarily unavailable. Please try again later."}</p>
        <noscript><p>Please enable JavaScript to complete the bot check and sign up.</p></noscript>
      </form>
    </div>
  </div>
  <div class="copyright container">
    © {new Date().getFullYear()}&nbsp;
    {site.practiceName}
    <span
      >{site.footer.creditPrefix}&nbsp;
      <a href={site.footer.creditUrl} target="_blank" rel="noopener"
        >{site.footer.creditLabel}</a
      ></span
    >
  </div>
  <div class="legal container">
    <a href="/privacy">{site.footer.privacyLabel}</a> · <a
      href="/disclaimer">{site.footer.disclaimerLabel}</a
    >
  </div>
</footer>
<script>
  type TurnstileApi = {
    render: (container: HTMLElement, options: {
      sitekey: string;
      action: string;
      theme: string;
      size: string;
      appearance: "interaction-only";
      callback: (token: string) => void;
      "expired-callback": () => void;
      "error-callback": () => void;
    }) => string;
    reset: (widgetId: string) => void;
    remove: (widgetId: string) => void;
  };
  const turnstileWindow = window as Window & { turnstile?: TurnstileApi };
  let turnstileLoad: Promise<TurnstileApi> | undefined;

  function loadTurnstile() {
    if (turnstileWindow.turnstile) return Promise.resolve(turnstileWindow.turnstile);
    if (!turnstileLoad) {
      turnstileLoad = new Promise<TurnstileApi>((resolve, reject) => {
        const script = document.createElement("script");
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        script.setAttribute("data-astro-persist", "newsletter-turnstile-script");
        script.addEventListener("load", () => {
          if (turnstileWindow.turnstile) resolve(turnstileWindow.turnstile);
          else reject(new Error("Bot check unavailable"));
        }, { once: true });
        script.addEventListener("error", () => {
          script.remove();
          reject(new Error("Bot check unavailable"));
        }, { once: true });
        document.head.appendChild(script);
      }).catch((error) => {
        turnstileLoad = undefined;
        throw error;
      });
    }
    return turnstileLoad;
  }

  function initNewsletterForm() {
    const form = document.querySelector<HTMLFormElement>("[data-newsletter-form]");
    const status = form?.querySelector<HTMLElement>("[data-newsletter-status]");
    const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const container = form?.querySelector<HTMLElement>("[data-newsletter-turnstile]");
    if (!form || !status || !button || form.dataset.bound === "true") return;

    form.dataset.bound = "true";
    if (!container?.dataset.sitekey) {
      form.addEventListener("submit", (event) => event.preventDefault());
      return;
    }
    let token = "";
    let submitting = false;
    let widgetId: string | undefined;
    void loadTurnstile().then((api) => {
      if (!form.isConnected) return;
      status.textContent = "";
      widgetId = api.render(container, {
        sitekey: container.dataset.sitekey!, action: "signup", theme: "dark", size: "flexible",
        appearance: "interaction-only",
        callback: (value) => {
          token = value;
          button.disabled = submitting || !token;
          if (status.textContent === "Bot check expired. Please complete it again.") status.textContent = "";
        },
        "expired-callback": () => {
          token = "";
          button.disabled = true;
          if (!submitting) status.textContent = "Bot check expired. Please complete it again.";
        },
        "error-callback": () => {
          token = "";
          button.disabled = true;
          if (!submitting) status.textContent = "The bot check couldn’t load. Please reload this page and try again.";
        },
      });
      container.dataset.widgetId = widgetId;
    }).catch(() => {
      if (form.isConnected) status.textContent = "The bot check couldn’t load. Please reload this page and try again.";
    });
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (submitting || !token) return;
      submitting = true;
      const originalLabel = button.innerHTML;
      button.disabled = true;
      button.textContent = "Signing up…";
      status.textContent = "";

      try {
        const response = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({ ...Object.fromEntries(new FormData(form)), "cf-turnstile-response": token }),
        });
        const result = await response.json();
        if (typeof result.message !== "string") throw new Error("Signup failed");
        status.textContent = result.message;
        if (response.ok) form.reset();
      } catch {
        status.textContent = "We couldn’t complete your signup. Please try again in a moment.";
      } finally {
        submitting = false;
        token = "";
        button.disabled = true;
        button.innerHTML = originalLabel;
        if (form.isConnected && widgetId !== undefined) turnstileWindow.turnstile?.reset(widgetId);
      }
    });
  }

  initNewsletterForm();
  document.addEventListener("astro:page-load", initNewsletterForm);
  document.addEventListener("astro:before-swap", () => {
    const container = document.querySelector<HTMLElement>("[data-newsletter-turnstile]");
    if (container?.dataset.widgetId !== undefined) turnstileWindow.turnstile?.remove(container.dataset.widgetId);
  });
</script>
<style>
  .cta {
    position: relative;
    padding: clamp(5rem, 10vw, 9rem) 0;
    background: url("/images/uploads/kauai-hero.avif") center/cover no-repeat;
    color: var(--purple);
    text-align: left;
    overflow: hidden;
  }
  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(245, 240, 231, 0.38) 0%,
      rgba(245, 240, 231, 0.52) 100%
    );
    pointer-events: none;
  }
  .cta .container {
    position: relative;
    z-index: 1;
  }
  .cta h2 {
    max-width: 850px;
  }
  .cta p:not(.eyebrow) {
    max-width: 600px;
    margin: 1.5rem 0 2rem;
  }
  footer {
    background: var(--purple-dark);
    color: var(--cream);
  }
  .foot {
    display: grid;
    grid-template-columns: 1fr 0.5fr 1.3fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    padding-block: 5rem 3rem;
  }
  .wordmark {
    font-family: var(--serif);
    font-size: 2rem;
    text-decoration: none;
  }
  .wordmark i {
    font-size: 0.65em;
  }
  .foot p {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.8rem;
    line-height: 1.65;
  }
  .links {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .links a,
  .legal a {
    color: var(--cream);
    font-size: 0.82rem;
  }
  .legal {
    padding-bottom: 1.4rem;
  }
  .foot > div {
    min-width: 0;
  }
  .newsletter h2 {
    margin-bottom: 1rem;
    font-size: 1.8rem;
    line-height: 1.15;
  }
  .newsletter label {
    display: block;
    margin-bottom: 0.4rem;
    font-size: 0.8rem;
  }
  .newsletter input {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem;
    border: 1px solid var(--sage);
    border-radius: 4px;
    background: var(--paper);
    color: var(--purple-dark);
    font: inherit;
    font-size: 0.9rem;
  }
  .newsletter :is(input, button):focus-visible {
    outline: 2px solid var(--cream);
    outline-offset: 4px;
  }
  .newsletter .newsletter-note {
    margin: 0.75rem 0 1rem;
    font-size: 0.72rem;
  }
  .newsletter button {
    cursor: pointer;
    font-family: inherit;
    font-size: 0.85rem;
  }
  .newsletter-bot-check {
    margin-bottom: 1rem;
  }
  .newsletter button:disabled {
    cursor: wait;
    opacity: 0.7;
  }
  .newsletter-trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .newsletter .newsletter-status {
    margin: 0.75rem 0 0;
    color: var(--cream);
  }
  @media (min-width: 801px) and (max-width: 1050px) {
    .foot {
      grid-template-columns: 1fr 1fr;
    }
  }
  .copyright {
    display: flex;
    justify-content: space-between;
    padding-block: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--sage);
    font-size: 0.72rem;
  }
  @media (max-width: 800px) {
    .foot {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .copyright {
      gap: 1rem;
      flex-direction: column;
    }
  }
</style>
