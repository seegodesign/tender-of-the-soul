---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
interface Props { title?: string; description?: string; image?: string; }
const { title = 'Tender of the Soul | Hakomi on Kauaʻi', description = 'Trauma-informed Hakomi and mindful, body-centered support for adults, online and in person on Kauaʻi.', image = '/images/uploads/hands-with-light.webp' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width">
    <link rel="icon" href="/favicon.svg"><meta name="generator" content={Astro.generator}>
    <title>{title}</title><meta name="description" content={description}><link rel="canonical" href={canonical}>
    <meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={new URL(image, Astro.url)}><meta property="og:type" content="website">
    <meta name="twitter:card" content="summary_large_image">
    <ClientRouter />
  </head>
  <body><a class="skip" href="#main">Skip to content</a><Header/><main id="main"><slot/></main><Footer/></body>
</html>
<style>.skip{position:fixed;z-index:100;top:8px;left:8px;transform:translateY(-150%);padding:.7rem 1rem;background:#fff}.skip:focus{transform:none}</style>
